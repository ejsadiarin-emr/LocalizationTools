<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataBank.Cli</RootNamespace>
    <AssemblyName>dv-extract</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Helpers\EncodingDetector.cs" Link="Helpers\EncodingDetector.cs" />
    <Compile Include="..\..\src\Helpers\CoverageAnalyzer.cs" Link="Helpers\CoverageAnalyzer.cs" />
  </ItemGroup>

</Project>
