STRINGTABLE
BEGIN
    IDS_ABOUTBOX            "&About DeltaV Workstation Configuration..."
    IDS_PRIMARY_OR_SECONDARY_APP_STATION 
                            "A node with redundancy subsystem enabled has been selected. Is this the Preferred Active application station?"
    IDS_HELLO_STRING        "\r\n\r\n   DeltaV Workstation Configuration will help you install and \r\n   configure your DeltaV workstation(s).         \r\n\r\n\r\n\r\n\r\n\r\n   If you are ready to proceed, press the NEXT button\r\n   and let's begin!"
    IDS_TITLE               "PC Install"
    IDS_FAILURE_COPY_UNINSTALL_FILES "Failed to copy uninstall information."
    IDS_RERUN_REGALL        "Some registry entries are missing in this system. Please run regall.cmd from the deltav bin directory and  rerun DeltaV Workstation Configuration again."
    IDS_STRING107           "rerun DeltaV Workstation Configuration  again."
    IDS_COULD_NOT_CONTACT_DC 
                            "A domain controller could not be contacted. Make sure your network configuration is correct."
    IDS_NEED_TO_BE_DOMAIN_ADMINISTRATOR 
                            "Domain administrator rights are required to perform DeltaV Workstation Configuration except for the Simulate workstation type.\n\nChoose Yes to exit Workstation Configuration,  No to configure this workstation as Simulate."
    IDS_SELECT_BETTER       "Please click on the workstation name you wish to select. Avoid clicking on white space."
    IDS_NOCOPYONLINEUPGRADE """Copy Online Upgrade Files"" option is unable to be deselected during the Upgrade Process."
END

STRINGTABLE
BEGIN
    IDS_DISABLING_BUILTIN_ADMINISTRATOR 
                            "You are currently logged on as the built-in Administrator.  To increase DeltaV security, DeltaV Workstation Configuration disables the built-in Administrator account.  Create a new account (or use an existing account) that is a member of the Administrators (or Domain Admins) group. Then log in as this account.\n\nDeltaV Workstation Configuration will not continue as long as the current logged on user is the built-in Administrator."
    IDS_SECURITY_HARDENING_NOT_COMPLETED 
                            "A DeltaV security feature was not fully completed.  Workstation Configuration will attempt to apply the security feature again.  Click OK to continue or Cancel to skip."
    IDS_SKIDLAPTOP          "\r\n   Please verify the required information below and then press the\n   NEXT button."
    IDS_LANCARDASSIGNMENT_SKID 
                            "\r\n   In this step, specify the network cards to assume the primary\n   network function. The selected network card will be used to\n   communicate with DeltaV PK Controllers and other remote\n   nodes (via the PK controller)."
    IDS_INSTALL_SKID_WRKSTN "\r\n   Your workstation is being configured to run DeltaV PK\n   Controller Engineering Software. The configuration process is\n   fully automatic. When the install has completed, your machine\n   will either be restarted or logged off, depending on its initial\n   state."
    IDS_HELLO_SKID_STRING   "\r\n\r\n   DeltaV Workstation Configuration will help you install and \r\n   configure your DeltaV PK Controller Engineering Software.         \r\n\r\n\r\n\r\n\r\n\r\n   If you are ready to proceed, press the NEXT button\r\n   and let's begin!"
    IDS_DOMAIN_CONTROLLER_IDDC_NOT_ALLOWED 
                            "This workstation is a primary domain controller.\r\nYou may not choose Independent DeltaV Domain Controller settings when configuring a primary domain controller."
    IDS_NO_CONTACT_IDDC_ERROR 
                            "An error occurred while trying to contact the domain controller for the entered domain.\nPlease make sure you entered the correct domain name."
    IDS_INSTALL_PK_SERVER_SERVICES_ERROR 
                            "An error occurred while installing PkProjectService.\nTry rebooting your computer or see your administrator for an explanation of error :"
    IDS_INSTALL_PK_CONFIG_SERVER_SERVICES_ERROR 
                            "An error occurred while installing ConfigChangeService.\nTry rebooting your computer or see your administrator for an explanation of error :"
    IDS_INSTALL_DVCH_HOUSEKEEPER_SERVICES_ERROR 
                            "An error occurred while installing DvLFM service.\nTry rebooting your computer or see your administrator for an explanation of error :"
    IDS_DVCHE_SERVER_ISO_MISSING 
                            "DVCH Elite Server and Client cannot be installed if the DeltaV installer ISO is no longer mounted. Ensure the ISO is mounted and then click OK to proceed with the install."
    IDS_DVCHE_CLIENT_ISO_MISSING 
                            "DVCH Elite Client cannot be installed if the DeltaV installer ISO is no longer mounted. Ensure the ISO is mounted and then click OK to proceed with the install."
    IDS_DVCHE_INVALID_EXE   "DVCH Elite components are not installed due to an invalid digital signature. Click OK to continue the configuration of the DeltaV workstation."
END

STRINGTABLE
BEGIN
    IDS_REMOVEDISK_WARNING  "You must remove the floppy disk from drive A: before Windows may be restarted."
    IDS_SYSTEM_RESTART_ERROR 
                            "An error was encountered while attempting to restart Windows. \nYou must restart Windows manually in order for any changes to take effect. "
    IDS_FILE_SERVICES_GET_FILES_AND_DIRS_ERROR
                            "One or more files or folders could not be listed for granting privileges. \n\nPlease see Installation log for details."
