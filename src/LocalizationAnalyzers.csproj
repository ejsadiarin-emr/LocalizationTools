<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- NuGet package metadata -->
    <PackageId>LocalizationAnalyzers</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Localization Analyzers Contributors</Authors>
    <Description>Roslyn analyzers for detecting behavioral strings and unlocalized display strings in C# code.</Description>
    <PackageTags>analyzers;localization;roslyn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Analyzer NuGet package requirements -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- CLI tool configuration (net10.0 only) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>Exe</OutputType>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- dotnet tool pack: pass -p:PackAsDotnetTool=true to create a tool package -->
  <PropertyGroup Condition="'$(PackAsDotnetTool)' == 'true'">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>localization-analyzers</ToolCommandName>
    <PackageId>LocalizationAnalyzers.Tool</PackageId>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DevelopmentDependency>false</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <!-- Exclude sibling project directories from SDK globbing -->
  <ItemGroup>
    <Compile Remove="LocalizationAnalyzers.Tests\**" />
    <Compile Remove="LocalizationAnalyzers.Desktop\**" />
    <Compile Remove="DataBank.Cli\**" />
    <Compile Remove="DataBank.Cli.Tests\**" />
    <Compile Remove="Helpers\**" />
    <EmbeddedResource Remove="LocalizationAnalyzers.Tests\**" />
    <EmbeddedResource Remove="LocalizationAnalyzers.Desktop\**" />
    <EmbeddedResource Remove="DataBank.Cli\**" />
    <EmbeddedResource Remove="DataBank.Cli.Tests\**" />
    <EmbeddedResource Remove="Helpers\**" />
    <None Remove="LocalizationAnalyzers.Tests\**" />
    <None Remove="LocalizationAnalyzers.Desktop\**" />
    <None Remove="DataBank.Cli\**" />
    <None Remove="DataBank.Cli.Tests\**" />
    <None Remove="Helpers\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Analyzer assemblies go in the analyzers folder of the NuGet package (not the tool package) -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"
          Condition="'$(PackAsDotnetTool)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="System.Composition" Version="10.0.9" />
  </ItemGroup>

  <!-- CA rules: only available for the CLI tool (net10.0), not the analyzer package (netstandard2.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302" />
  </ItemGroup>

</Project>
