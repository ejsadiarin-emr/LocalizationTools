  "runs": [
    {
      "tool": {
        "driver": {
          "name": "LocalizationAnalyzers",
          "version": "1.0.0",
          "informationUri": "https://github.com/your-org/LocalizationAnalyzers",
          "rules": [
            {
              "id": "LOC010",
              "name": "LOC010",
              "shortDescription": {
                "text": "Display string not localized"
              },
              "fullDescription": {
                "text": "Display strings shown to users should be routed through Localize() for translation."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC013",
              "name": "LOC013",
              "shortDescription": {
                "text": "Dynamic resource key in localizer"
              },
              "fullDescription": {
                "text": "Dynamic resource keys (interpolation, concatenation, variables) prevent localization tooling from extracting translatable strings."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC014",
              "name": "LOC014",
              "shortDescription": {
                "text": "English-only pluralization pattern"
              },
              "fullDescription": {
                "text": "English-only pluralization (count == 1 ? singular : plural) doesn\u0027t work for languages with complex plural forms (Russian, Arabic, etc.)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC005",
              "name": "LOC005",
              "shortDescription": {
                "text": "Hardcoded date/number format string"
              },
              "fullDescription": {
                "text": "Hardcoded date/number format strings produce locale-dependent output. Use CultureInfo-aware formatting instead."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC012",
              "name": "LOC012",
              "shortDescription": {
                "text": "Hardcoded date/time format string"
              },
              "fullDescription": {
                "text": "Hardcoded date/time format strings without CultureInfo produce locale-dependent output. Use CultureInfo.InvariantCulture or a culture-aware format."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC007",
              "name": "LOC007",
              "shortDescription": {
                "text": "Hardcoded pluralization logic"
              },
              "fullDescription": {
                "text": "Hardcoded pluralization (e.g., count == 1 ? \u0022item\u0022 : \u0022items\u0022) doesn\u0027t work for languages with complex plural forms (Russian, Arabic, etc.)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC006",
              "name": "LOC006",
              "shortDescription": {
                "text": "Missing StringComparison parameter"
              },
              "fullDescription": {
                "text": "String methods without StringComparison use culture-dependent defaults, which can cause unexpected behavior across locales."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC015",
              "name": "LOC015",
              "shortDescription": {
                "text": "Punctuation outside translatable string"
              },
              "fullDescription": {
                "text": "Punctuation outside translatable strings prevents translators from adjusting punctuation for the target language."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC004",
              "name": "LOC004",
              "shortDescription": {
                "text": "String concatenation in output context"
              },
              "fullDescription": {
                "text": "String concatenation in output contexts produces untranslatable fragments. Use string interpolation or resource keys instead."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC001",
              "name": "LOC001",
              "shortDescription": {
                "text": "String literal in conditional expression"
              },
              "fullDescription": {
                "text": "String literals in conditionals break when translated. Use resource keys instead."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC002",
              "name": "LOC002",
              "shortDescription": {
                "text": "String literal in data access call"
              },
              "fullDescription": {
                "text": "String literals in data access calls break when translated. Use resource keys or constants."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC003",
              "name": "LOC003",
              "shortDescription": {
                "text": "String literal in equality comparison"
              },
              "fullDescription": {
                "text": "String literals in equality comparisons break when translated. Use resource keys or constants."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            },
            {
              "id": "LOC011",
              "name": "LOC011",
              "shortDescription": {
                "text": "String interpolation in localizable context"
              },
              "fullDescription": {
                "text": "String interpolation in localizable contexts prevents translators from reordering words. Use composite formatting with resource keys instead."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Localization"
              }
            }
          ]
        }
      },
